# Server Settings
PROJECT_NAME="NSAIPETROSOFT API"
ENVIRONMENT="development"
PORT=8000
DB_ECHO=false

# Database URL
# In Railway: Railway automatically creates and sets DATABASE_URL when you link a PostgreSQL plugin.
# Local development format:
DATABASE_URL="postgresql+asyncpg://postgres:postgres@localhost:5432/nsaipetrosoft"

# CORS origins: comma-separated list of allowed URLs
# Add your Cloudflare Pages domain here once deployed:
# e.g.: https://nsaipetrosoft.pages.dev,http://localhost:5173
CORS_ORIGINS="http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173,https://nsaipetrosoft.pages.dev"

# Cloudflare R2 Object Storage for Automated Disaster Recovery Backups
# Get these from Cloudflare Dashboard -> R2 -> Manage R2 API Tokens
R2_ACCOUNT_ID="your_cloudflare_account_id_here"
R2_ACCESS_KEY_ID="your_r2_access_key_id_here"
R2_SECRET_ACCESS_KEY="your_r2_secret_access_key_here"
R2_BUCKET_NAME="nsaipetrosoft-backups"

# Decentro Banking-as-a-Service (BaaS) API Credentials
# Obtain these from Decentro Developer Dashboard: https://admin.decentro.tech
DECENTRO_CLIENT_ID="your_decentro_client_id"
DECENTRO_CLIENT_SECRET="your_decentro_client_secret"
DECENTRO_MODULE_SECRET="your_decentro_module_secret"
DECENTRO_PROVIDER_SECRET="your_decentro_provider_secret"
DECENTRO_WEBHOOK_SECRET="your_decentro_webhook_hmac_secret"
DECENTRO_BASE_URL="https://in.staging.decentro.tech"
DECENTRO_TIMEOUT_SECONDS=30.0
DECENTRO_MAX_RETRIES=3
DECENTRO_VAN_PREFIX="NSAI"
DECENTRO_MASTER_ACCOUNT="912345678901"
DECENTRO_MASTER_IFSC="YESB0CMSNOC"
DECENTRO_SIMULATION_MODE=false
